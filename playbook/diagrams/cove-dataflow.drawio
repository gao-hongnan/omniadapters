        </mxCell>
        <mxCell id="c_provider" value="&lt;b&gt;LLM provider&lt;/b&gt;&lt;br&gt;OpenAI · Anthropic · Gemini" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="laneC">
