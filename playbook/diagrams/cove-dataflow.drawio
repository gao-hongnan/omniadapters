        </mxCell>
        <mxCell id="c_port" value="&lt;b&gt;StructuredLLM&lt;/b&gt;.acreate&lt;br&gt;(messages, response_model)&lt;br&gt;optional: Throttled · Budgeted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;dashed=1;" vertex="1" parent="laneC">
          <mxGeometry x="720" y="62" width="220" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c_pai" value="&lt;b&gt;PydanticAIStructuredLLM&lt;/b&gt;&lt;br&gt;OutputMode picks ToolOutput, NativeOutput&lt;br&gt;or PromptedOutput (auto: the model's default)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="laneC">
          <mxGeometry x="1000" y="62" width="290" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c_agent" value="&lt;b&gt;pydantic-ai Agent.run&lt;/b&gt;&lt;br&gt;prompt = user, instructions = system&lt;br&gt;validates the reply as response_model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="laneC">
