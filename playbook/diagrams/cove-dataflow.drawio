        </mxCell>
        <mxCell id="c_prompt" value="&lt;b&gt;Prompt&lt;/b&gt; (JinjaPrompt)&lt;br&gt;renders the brief's fields;&lt;br&gt;an undefined name raises" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="laneC">
          <mxGeometry x="240" y="62" width="200" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="c_msgs" value="&lt;b&gt;Messages&lt;/b&gt;&lt;br&gt;(system, user)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.17;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneC">
