        <mxCell id="c_brief" value="&lt;b&gt;brief&lt;/b&gt;&lt;br&gt;e.g. WitnessBrief" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.17;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneC">
