<mxfile host="drawio">
  <diagram id="cove-dataflow" name="CoVe dataflow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2300" pageHeight="1150" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;omniadapters.services.cove&lt;/b&gt; · dataflow of one chain-of-verification run" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1400" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Chain-of-Verification (Dhuliawala et al. 2023, arXiv:2309.11495): draft an answer, plan verification questions, answer them independently, then rule. From config, every role runs on a pydantic-ai agent." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="0" y="32" width="1600" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="laneA" value="① Setup · open_factual_qa(config): one pydantic-ai agent per role, opened once and closed on exit" style="swimlane;startSize=32;html=1;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;" vertex="1" parent="1">
          <mxGeometry x="0" y="70" width="2220" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="a_cfg" value="&lt;b&gt;config.yaml + .env&lt;/b&gt;&lt;br&gt;roles · procedure · limits&lt;br&gt;API keys from the environment" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="laneA">
          <mxGeometry x="30" y="48" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a_conf" value="&lt;b&gt;FactualQAConfig&lt;/b&gt; · a RoleConfig per role&lt;br&gt;provider_config · model_name · model_settings&lt;br&gt;output_mode · output_retries" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="laneA">
          <mxGeometry x="290" y="48" width="280" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="a_open" value="&lt;b&gt;open_role&lt;/b&gt;(config, name=role)&lt;br&gt;build_model → Agent(model_settings, retries)&lt;br&gt;async with agent: closes its HTTP client" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="laneA">
          <mxGeometry x="630" y="48" width="280" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="a_llm" value="&lt;b&gt;PydanticAIStructuredLLM&lt;/b&gt; × 4&lt;br&gt;proponent · contrarian · witness · judge&lt;br&gt;each satisfies the StructuredLLM port" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="laneA">
          <mxGeometry x="970" y="48" width="280" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="a_build" value="&lt;b&gt;build_factual_qa&lt;/b&gt;(roles, procedure)&lt;br&gt;one llm_step per role&lt;br&gt;prompts checked against briefs at build" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="laneA">
          <mxGeometry x="1310" y="48" width="280" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="ea1" value="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#fffaf3;" edge="1" parent="laneA" source="a_cfg" target="a_conf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ea2" value="per role" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#fffaf3;" edge="1" parent="laneA" source="a_conf" target="a_open">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=10;" edge="1" parent="laneA" source="a_open" target="a_llm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ea4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=10;" edge="1" parent="laneA" source="a_llm" target="a_build">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="laneB" value="② ChainOfVerification.run(case) · one hearing with the Factored procedure" style="swimlane;startSize=32;html=1;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f7faff;" vertex="1" parent="1">
          <mxGeometry x="0" y="260" width="2220" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="eab" value="returns the engine" style="exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6532;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a_build" target="laneB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="n_court" value="&lt;b&gt;Every step goes through the Court&lt;/b&gt; (a Stand per challenge)&lt;br&gt;• semaphore: max_concurrent_steps, shared by every run of the engine&lt;br&gt;• deadline: timeout_s, or witness_timeout_s per challenge&lt;br&gt;• step events → observers; finished steps → transcript.record&lt;br&gt;• a failing proponent, contrarian or judge → StepFailedError" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="30" y="46" width="500" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n_proc" value="&lt;b&gt;The procedure is the paper's variant&lt;/b&gt;; swap Factored for:&lt;br&gt;• TwoStep: one panel answers every challenge at once&lt;br&gt;• Joint: one inquisitor asks and answers (sees the proposal)&lt;br&gt;• FactorRevise: a cross-examiner checks each testimony&lt;br&gt;• your own Procedure, calling steps through the Court" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="560" y="46" width="480" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="n_hide" value="&lt;b&gt;Information hiding&lt;/b&gt;: a WitnessBrief has no proposal field, so testimony cannot&lt;br&gt;repeat the draft's errors, the paper's key finding. The brief's type and a template&lt;br&gt;check at build time enforce it. A witness that raises or times out becomes&lt;br&gt;Unanswered, and the quorum decides whether the hearing carries on." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="1350" y="46" width="610" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="b_case" value="&lt;b&gt;case&lt;/b&gt;&lt;br&gt;e.g. Question" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.17;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="30" y="170" width="110" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_prop" value="&lt;b&gt;Proponent&lt;/b&gt;&lt;br&gt;sees CaseBrief(case)&lt;br&gt;drafts an answer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="200" y="170" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_proposal" value="&lt;b&gt;proposal&lt;/b&gt;&lt;br&gt;e.g. Answer" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.17;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="410" y="170" width="110" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_contra" value="&lt;b&gt;Contrarian&lt;/b&gt;&lt;br&gt;sees ContrarianBrief&lt;br&gt;(case, proposal)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="580" y="170" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_chal" value="&lt;b&gt;challenges&lt;/b&gt;&lt;br&gt;court.admit:&lt;br&gt;min ≤ n ≤ max" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.17;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="830" y="170" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_w1" value="&lt;b&gt;Witness&lt;/b&gt; · challenge 1&lt;br&gt;sees WitnessBrief&lt;br&gt;(case, challenge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="1080" y="60" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_w2" value="&lt;b&gt;Witness&lt;/b&gt; · challenge 2&lt;br&gt;sees WitnessBrief&lt;br&gt;(case, challenge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="1080" y="170" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_w3" value="&lt;b&gt;Witness&lt;/b&gt; · challenge n&lt;br&gt;sees WitnessBrief&lt;br&gt;(case, challenge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="1080" y="280" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_evid" value="&lt;b&gt;evidence&lt;/b&gt;&lt;br&gt;one outcome per challenge:&lt;br&gt;Answered | Unanswered" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.17;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="1350" y="170" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_judge" value="&lt;b&gt;Judge&lt;/b&gt;&lt;br&gt;sees JudgeBrief(case, proposal,&lt;br&gt;evidence, hearing)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="1580" y="170" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b_retry" value="&lt;b&gt;retrial?&lt;/b&gt;&lt;br&gt;reconsider(ruling)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="1830" y="160" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b_trans" value="&lt;b&gt;Transcript&lt;/b&gt;&lt;br&gt;hearings · disposition · record&lt;br&gt;.ruling · .to_json()" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneB">
          <mxGeometry x="2010" y="160" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="eb1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#4d4d4d;strokeWidth=1.5;fontSize=10;" edge="1" parent="laneB" source="b_case" target="b_prop">
