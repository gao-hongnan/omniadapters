        <mxCell id="laneC" value="③ Inside every role's step · llm_step(llm, prompt, response_model, parse)" style="swimlane;startSize=32;html=1;fontSize=14;fontStyle=1;align=left;spacingLeft=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fbf8fc;" vertex="1" parent="1">
