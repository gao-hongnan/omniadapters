        <mxCell id="c_result" value="&lt;b&gt;step result&lt;/b&gt;&lt;br&gt;back to the Court" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.17;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="laneC">
